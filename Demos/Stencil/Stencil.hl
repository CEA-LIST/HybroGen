// -*- c -*-
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <assert.h>
#include "ReadPgmImage.h"

typedef  int (*pifc)(int[], int, int, int);


void printImage(imgStruct_t *img, char *imageName)
{
  printf ("ImageName & size: %s %dx%d\n", imageName, img->height, img->width);
  for(int line = 0 ; line < img->height ; line++)
	{
	  for(int column = 0 ; column < img->width ; column++)
		{
		  printf("%03d ", img->pixelsArray[line*img->width+column]);
		}
	  printf("\n");
	}
  printf("\n");
}

int imgSum (imgStruct_t *img)
{
  int line, column, sum;
  sum = 0;
  for(int line = 0 ; line < img->height ; line++)
	{
	  for(int column = 0 ; column < img->width; column++)
		{
		  sum += img->pixelsArray[line*img->width+column];
		}
	}
  return (0 == sum)?1:sum;
}

#if 0
unsigned char clamp(int value)
{
  return (unsigned char)(0 > value)?0:(255 < value)?255:value;
}
#else
#define clamp(value) ((unsigned char)(0 > value)?0:(255 < value)?255:value)
#endif

pifc genKernel1x1(pifc ptr, int* Filter, int coeff)
{
#[
  int 32 1 kernel (int[] 32 1 In, int 32 1 line, int 32 1 column, int 32 1 imgWidth)
    {
      int 32 1 sum;
	  sum = In[line*imgWidth+column] * #(Filter[0]);
      return sum/#(coeff);
    }
  ]#
  return ptr;
}

pifc genKernel3x3(pifc ptr, int* Filter, int coeff)
{
#[
  int 32 1 kernel (int[] 32 1 In, int 32 1 line, int 32 1 column, int 32 1 imgWidth)
    {
      int 32 1 sum, ni, njp1, njm1, stride;

	  njp1 = column + 1;
	  njm1 = column - 1;

      ni  = line-1;
      stride = ni * imgWidth;
	  sum =       In[stride + njm1]   * #(Filter[0]);
	  sum = sum + In[stride + column] * #(Filter[1]);
	  sum = sum + In[stride + njp1]   * #(Filter[2]);

	  ni  = line;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm1]   * #(Filter[1*3+0]);
	  sum = sum + In[stride + column] * #(Filter[1*3+1]);
	  sum = sum + In[stride + njp1]   * #(Filter[1*3+2]);

      ni  = line+1;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm1]   * #(Filter[2*3+0]);
	  sum = sum + In[stride + column] * #(Filter[2*3+1]);
	  sum = sum + In[stride + njp1]   * #(Filter[2*3+2]);
      return sum/#(coeff);
    }
  ]#
  return ptr;
}

pifc genKernel5x5(pifc ptr, int* Filter, int coeff)
{
  #[
    int 32 1 kernel (int[] 32 1 In, int 32 1 line, int 32 1 column, int 32 1 imgWidth)
    {
      int 32 1 sum, ni, njm2, njm1, njp1, njp2, stride;

	  njm2  = column - 2;
	  njm1  = column - 1;
	  njp1  = column + 1;
	  njp2  = column + 2;

      ni = line-2;
      stride = ni * imgWidth;
  	  sum =       In[stride + njm2]   * #(Filter[0*5+0]);
      sum = sum + In[stride + njm1]   * #(Filter[0*5+1]);
      sum = sum + In[stride + column] * #(Filter[0*5+2]);
      sum = sum + In[stride + njp1]   * #(Filter[0*5+3]);
      sum = sum + In[stride + njp2]   * #(Filter[0*5+4]);

      ni = line-1;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm2]   * #(Filter[1*5+0]);
      sum = sum + In[stride + njm1]   * #(Filter[1*5+1]);
      sum = sum + In[stride + column] * #(Filter[1*5+2]);
      sum = sum + In[stride + njp1]   * #(Filter[1*5+3]);
      sum = sum + In[stride + njp2]   * #(Filter[1*5+4]);

      ni = line;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm2]   * #(Filter[2*5+0]);
      sum = sum + In[stride + njm1]   * #(Filter[2*5+1]);
      sum = sum + In[stride + column] * #(Filter[2*5+2]);
      sum = sum + In[stride + njp1]   * #(Filter[2*5+3]);
      sum = sum + In[stride + njp2]   * #(Filter[2*5+4]);

      ni = line+1;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm2]   * #(Filter[3*5+0]);
      sum = sum + In[stride + njm1]   * #(Filter[3*5+1]);
	  sum = sum + In[stride + column] * #(Filter[3*5+2]);
      sum = sum + In[stride + njp1]   * #(Filter[3*5+3]);
      sum = sum + In[stride + njp2]   * #(Filter[3*5+4]);

      ni = line+2;
      stride = ni * imgWidth;
	  sum = sum + In[stride + njm2]   * #(Filter[4*5+0]);
      sum = sum + In[stride + njm1]   * #(Filter[4*5+1]);
      sum = sum + In[stride + column] * #(Filter[4*5+2]);
      sum = sum + In[stride + njp1]   * #(Filter[4*5+3]);
      sum = sum + In[stride + njp2]   * #(Filter[4*5+4]);
      return sum / #(coeff);
    }
  ]#
  return ptr;
#if 0
#endif
}

// Compute a stencil for 1 point
int kernelStatic(imgStruct_t *In, int l, int c, imgStruct_t *Filter, int coeff)
{
  int line, column, sum = 0;
  int offset = (Filter->width)/2;

  for (line = 0; line < Filter->height; line++)
	{
      for (column = 0; column < Filter->width; column++)
		{
		  int ni = (l   + line)   - offset;
		  int nj = (c   + column) - offset;
		  sum += In->pixelsArray[ni*In->width+nj] * Filter->pixelsArray[line*Filter->width+column];
		}
	}
    return sum / coeff;
}


void convolutionStatic(imgStruct_t *In, imgStruct_t *Out, imgStruct_t *Filter, int coeff)
{
  int offset = Filter->width/2;
  int result;
  for (int line = offset; line < In->height - offset; line++)
	{
	  for (int column = offset; column < In->width - offset; column++)
		{
		  result = kernelStatic(In, line, column, Filter, coeff);
		  Out->pixelsArray[line*Out->width+column] =  clamp(result);
		}
    }
}

void convolutionH4(imgStruct_t* In, imgStruct_t *Out, imgStruct_t *Filter, pifc kernelHL)
{
  int offset = Filter->width/2;
  int result;
  for (int line = offset; line < In->height - offset; line++)
    {
      for (int column = offset; column <  In->width - offset; column++)
        {
          result = kernelHL(In->pixelsArray, line, column, In->width);
          Out->pixelsArray[line*Out->width+column] = clamp(result);
        }
    }
}

int compareImages(imgStruct_t *staticImg, imgStruct_t *H4Img)
{
  int errors = 0;
  for(int line = 0 ; line < staticImg->height ; line++)
	{
	  for(int column = 0 ; column < staticImg->width ; column++)
		{
		  if((staticImg->pixelsArray[line*staticImg->width+column] - H4Img->pixelsArray[line*H4Img->width+column])  != 0)
			{
			  if (0 == errors)
                {
                  printf("Alert : first difference at line %i column %i\n", line, column);
                }
			  errors++;
			}
		}
	}
  return errors;
}

int main(int argc, char *argv[])
{
  int error, coeff, nXperiment = 20;
  imgStruct_t *In, *OutH4, *OutStatic, *Filter;
  char *filterImageName, *inputImageName;
  if (argc < 5)
    {
      printf ("./Stencil <InputImageName> <outputStaticImageName> <outputH4ImageName> <Filter Img>\n");
      exit(-1);
    }

  inputImageName  = argv[1];
  filterImageName = argv[4];
  In     = readPgmImage(inputImageName);
  Filter = readPgmImage(filterImageName);
  coeff = imgSum (Filter);
#ifdef VERBOSE
  printf ("%s: coeff %d\n", filterImageName, coeff);
  printImage (Filter, "Filter");
#endif
  assert (Filter->width == Filter->height); // Only square filters
  OutStatic = createImage (In->height, In->width);
  OutH4     = createImage (In->height, In->width);
#ifdef VERBOSE
  printf ("after init\n");
  printImage(In, "In");
#endif
  ticks_t timeStatic = h2_getticks();   // Static convolution
  for (int i = 0; i < nXperiment; i++)
	{
	  convolutionStatic(In, OutStatic, Filter, coeff);
	}
  timeStatic = h2_getticks() - timeStatic;
#ifdef VERBOSE
  printf ("after static\n");
  printImage(OutStatic, "Out");
#endif

  pifc kernelHL = (pifc)h2_malloc(8192);
  ticks_t timeCodeGen = h2_getticks();
  switch (Filter->width)
    {
    case 1 : kernelHL = genKernel1x1 (kernelHL, Filter->pixelsArray, coeff); break;
    case 3 : kernelHL = genKernel3x3 (kernelHL, Filter->pixelsArray, coeff); break;
    case 5 : kernelHL = genKernel5x5 (kernelHL, Filter->pixelsArray, coeff); break;
    default: printf ("Unknown filter size\n"); exit(-1);
    }
  timeCodeGen = h2_getticks() - timeCodeGen;

#ifdef VERBOSE
  printf ("after codegen\n");
#endif

  ticks_t timeH4 = h2_getticks(); // Compilette convolution
  for (int i = 0; i < nXperiment; i++)
	{
	  convolutionH4(In, OutH4, Filter, kernelHL);
	}
  timeH4 = h2_getticks() - timeH4;
#ifdef VERBOSE
  printf ("after h2\n");
  printImage(OutH4, "Out H4");
#endif
  error = compareImages(OutH4, OutStatic);
  printf("%s;%ix%i;%ix%i;%lld;%lld;%lld;%d;%d\n",
		 filterImageName,
		 Filter->width, Filter->height, In->width, In->height,
		 timeStatic/nXperiment, timeH4/nXperiment,
		 h2_codeGenTime, h2_insnGenerated,
         error);

#if VERBOSE
  writePgmImage(OutStatic, argv[2]);
  writePgmImage(OutH4,     argv[3]);
#endif

  return (0 == error)?0:-1;
}

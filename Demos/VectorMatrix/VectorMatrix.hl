/* -*- c -*- */
// https://gitlab.freedesktop.org/mesa/mesa/-/blob/main/src/mesa/math/m_matrix.c
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <strings.h>
#define T 4
typedef int d_t;
typedef d_t matrix_t [T][T];
typedef d_t vector_t [T];
typedef d_t (*pifvv)(vector_t, vector_t);

pifvv genVectorMatrixProduct(pifvv ptr, matrix_t m)
{
  #[
  int 32 1 add (int[] 32 1 o, int[] 32 1 i)
   {
     o[0] = i[0]*#(m[0][0]) + i[1]*#(m[1][0]) + i[2]*#(m[2][0]) + i[3]*#(m[3][0]);
     o[1] = i[0]*#(m[0][1]) + i[1]*#(m[1][1]) + i[2]*#(m[2][1]) + i[3]*#(m[3][1]);
     o[2] = i[0]*#(m[0][2]) + i[1]*#(m[1][2]) + i[2]*#(m[2][2]) + i[3]*#(m[3][2]);
     o[3] = i[0]*#(m[0][3]) + i[1]*#(m[1][3]) + i[2]*#(m[2][3]) + i[3]*#(m[3][3]);
   }
  return o[3];
  ]#
  return ptr;
}

d_t VectorMatrixProductUnrolled (vector_t o, vector_t i, matrix_t m)
{
  o[0] = i[0]*m[0][0] + i[1]*m[1][0] + i[2]*m[2][0] + i[3]*m[3][0];
  o[1] = i[0]*m[0][1] + i[1]*m[1][1] + i[2]*m[2][1] + i[3]*m[3][1];
  o[2] = i[0]*m[0][2] + i[1]*m[1][2] + i[2]*m[2][2] + i[3]*m[3][2];
  o[3] = i[0]*m[0][3] + i[1]*m[1][3] + i[2]*m[2][3] + i[3]*m[3][3];
  return o[3];
}

#if 0 // What the binary code should be with a translation matrix
d_t VectorMatrixProductUnrolledSR(vector_t o, vector_t i, matrix_t m)
{

  o[0] = m[0][0] * i[0] +                                 + m[3][0] * i[3];
  o[1] =                  m[1][1] * i[1] +                + m[3][1] * i[3];
  o[2] =                                   m[2][2] * i[2] + m[3][2] * i[3];
  o[3] =                                                  +           i[3];
  return o[3];
}
#endif
d_t VectorMatrixProduct (vector_t o, vector_t i, matrix_t m)
{
  for (int column = 0; column < T; column++)
    {
      o[column] = 0;
      for (int line = 0; line < T; line++)
        {
          o[column] += i[line] * m[line][column];

        }
    }
  return o[3];
}


int VectorMatrixProductCount(matrix_t mat)
{
  int op = 0;
  for (int column = 0; column < T; column++)
    {
      for (int line = 0; line < T; line++)
        {
          switch (mat[line][column])
            {
            case 0 : op += 0; break;
            case 1 : op += 1; break;
            default: op += 2; break;
            }
        }
    }
  return op;
}


void printMatrix (matrix_t m, char msg[])
{
  printf ("%s:\n", msg);
  for (int column = 0; column < T; column++)
    {
      for (int line = 0; line < T; line++)
        {
          printf ("%4d ", m[line][column]);
        }
      printf ("\n");
    }
  printf ("\n");
}

void printVector (vector_t v, char msg[])
{
  for (int i = 0; i < T; i++)
    printf ("%4d ", v[i]);
  printf ("%s\n", msg);
}

bool vectorCompare(vector_t ref[], vector_t other[], char * msg, int doPrint, int nVector)
{
  int has_differences = false;
  for (int line = 0; line < nVector; line++)
	for (int i = 0; i < T; i++)
	  {
		if (ref[line][i] != other[line][i])
		  has_differences = true;
		if (doPrint)
		  printf("%4d ", other[line][i]);
    }
  /* printf("%s : ", msg); */
  /* printf(" %s\n", (has_differences)?"NOT OK":"OK"); */
  return has_differences;
}

int main (int argc, char *argv[])
{
  matrix_t m;
  char *matrixName;
  //  vector_t in0  = {1, 2, 3, 4}, in1  = {5, 6, 7, 8};
  vector_t *out, *cout, *in;
  uint64_t timeGeneral, timeCompilette;
  pifvv vmProduct;
  int tmp, doPrint, nXperiment;
  unsigned long acc;
  bool resultValid;

  if (argc != 19)
    {
      printf ("Not enough arguments %d\n", argc);
      printf ("VectorMatrix ExperimentNumber MatrixName M11 M12 ... M44\n");
      exit (-1);
    }
  doPrint = 0;
  acc = 0;
  nXperiment = atoi (argv[1]);
  matrixName = argv[2];
  for (int line = 0; line < 4; line++)
    for (int column = 0; column < 4; column++)
      {
        m[line][column] = atoi (argv[3 + line*4+column]);
      }
#ifdef VERBOSE
  printMatrix(m, matrixName);
#endif

  in   = calloc(nXperiment, sizeof (vector_t));
  out  = calloc(nXperiment, sizeof (vector_t));
  cout = calloc(nXperiment, sizeof (vector_t));

  for (int line = 0; line < nXperiment; line++)
	for (int column = 0; column < 4; column++)
	  in[line][column] = random () % 1000;

  tmp = VectorMatrixProductCount (m);
  printf("Operation count Matrix %s : %d theoretical speedup %.1f\n", matrixName, tmp, (0==tmp)?32:32.0/tmp);

// Repeat one instruction and count ticks
#define DO(INSN, REPEAT, TIME) {uint64_t tickCount = h2_getticks();for (int i = 0; i < REPEAT; i++) INSN;  TIME = h2_getticks() - tickCount;}

#ifdef VERBOSE
  printVector (in1, "Input  vector");
#endif

  acc += VectorMatrixProduct (out[0], in[0], m); /* Cold start */
  DO(acc += VectorMatrixProduct (out[i], in[i], m), nXperiment, timeGeneral)

#ifdef VERBOSE
  printVector (out1, "Output vector   (general)");
#endif

#if 0 // Possible test with a source level unrolled version
  uint64_t timeUnrolled;
  vector_t uout0, uout1;
  acc += VectorMatrixProductUnrolled (uout0, in0, m);
  DO(acc += VectorMatrixProductUnrolled (uout1, in1, m), nXperiment, timeUnrolled);
  vectorCompare(out1, uout1, "Unrolled out0", doPrint);
#endif

  vmProduct = (pifvv) h2_malloc(1024);
  vmProduct = genVectorMatrixProduct (vmProduct, m);
  acc += vmProduct (cout[0], in[0]);
  DO(acc += vmProduct (cout[i], in[i]), nXperiment, timeCompilette);

  resultValid = vectorCompare(out, cout, "Compilette", doPrint, nXperiment);

  printf ("%s;%d;%lu;%lu;%lld;%d;%s\n",
		  matrixName, nXperiment,
		  timeGeneral, timeCompilette,
		  h2_codeGenTime, h2_insnGenerated,
		  resultValid?"true":"false");
  return resultValid;
}
